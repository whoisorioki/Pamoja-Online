---
layout: base.njk
pagination:
  data: sessions
  size: 1
  alias: session
permalink: "/week/{{ session.week }}/"
title: "Week {{ session.week }}: {{ session.theme }}"
---
<div class="card">
  <span class="badge">Week {{ session.week }} of 8</span>
  <h1 style="font-family: var(--font-heading); font-size: 1.75rem; margin-bottom: 0.5rem;">{{ session.theme }}</h1>
  <p style="color: var(--text-secondary); font-size: 1.05rem;">{{ session.insight }}</p>

    <div class="scripture-box">
    <span class="scripture-ref">{{ session.scripture }}</span>
  </div>
</div>

<!-- Video Join Section -->
<div class="card">
  <h2 class="card-title">📹 Friday Video Meet</h2>
  <p class="card-subtitle">Join our online video gathering for Week {{ session.week }}. Your facilitator shares the room password before the session — never share it outside the group.</p>
  
  <div id="jitsi-container" class="jitsi-container">
    <div class="jitsi-placeholder">
      <p style="font-weight: 600; margin-bottom: 0.5rem;">Room: {{ session.jitsi_room_id }}</p>
      <p style="font-size: 0.85rem; margin-bottom: 1rem;">Click below to load the secure video session.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; align-items: center;">
        <button class="btn btn-primary" id="start-jitsi-btn" onclick="launchJitsiSession('{{ session.jitsi_room_id }}')">
          Join Video Session
        </button>
        <a id="direct-jitsi-link" href="https://meet.jit.si/{{ session.jitsi_room_id }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="font-size: 0.9rem;">
          Open in New Tab ↗
        </a>
      </div>
    </div>
  </div>
</div>

<!-- 3-Part Group Rhythm -->
<div class="card">
  <h2 class="card-title" style="margin-bottom: 1.25rem;">📖 Group Discussion Rhythm</h2>

  <!-- Step 1: Look Back -->
  <div class="rhythm-step">
    <div class="rhythm-step-header">
      <span class="step-number">1</span>
      <h3 class="step-title">Look Back — Reflection & Check-in</h3>
    </div>
    <p style="color: var(--text-secondary); padding-left: 2rem;">
      {{ session.look_back }}
    </p>
  </div>

  <!-- Step 2: Look Into -->
  <div class="rhythm-step">
    <div class="rhythm-step-header">
      <span class="step-number">2</span>
      <h3 class="step-title">Look Into — Word & Insight</h3>
    </div>
    <p style="color: var(--text-secondary); padding-left: 2rem; margin-bottom: 0.5rem;">
      <strong>Core Question:</strong> {{ session.look_into_question }}
    </p>
    <p style="color: var(--text-secondary); padding-left: 2rem; font-style: italic;">
      "{{ session.reflection }}"
    </p>
  </div>

  <!-- Step 3: Look Up -->
  <div class="rhythm-step">
    <div class="rhythm-step-header">
      <span class="step-number">3</span>
      <h3 class="step-title">Look Up — Hope & Prayer</h3>
    </div>
    <ul style="padding-left: 3rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
      {% for question in session.look_up_questions %}
        <li>{{ question }}</li>
      {% endfor %}
    </ul>
    <div style="background: var(--accent-light); padding: 1rem; border-radius: 8px; margin-left: 2rem; color: var(--accent-primary);">
      <strong>Closing Prayer:</strong> {{ session.prayer }}
    </div>
  </div>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
  <a href="/" class="btn btn-secondary">← Back to Home</a>
  {% if session.week < 8 %}
    <a href="/week/{{ session.week + 1 }}/" class="btn btn-primary">Next Week →</a>
  {% endif %}
</div>

<script>
function getJitsiConfig(roomId) {
  const jaasAppId = window.JAAS_APP_ID;
  if (jaasAppId && jaasAppId.trim() !== '') {
    return {
      scriptUrl: `https://8x8.vc/${jaasAppId}/external_api.js`,
      domain: '8x8.vc',
      roomName: `${jaasAppId}/${roomId}`,
      directUrl: `https://8x8.vc/${jaasAppId}/${roomId}`
    };
  }
  return {
    scriptUrl: 'https://meet.jit.si/external_api.js',
    domain: 'meet.jit.si',
    roomName: roomId,
    directUrl: `https://meet.jit.si/${roomId}`
  };
}

// Update direct link href once DOM and window config are available
document.addEventListener('DOMContentLoaded', () => {
  const directLink = document.getElementById('direct-jitsi-link');
  if (directLink) {
    const config = getJitsiConfig('{{ session.jitsi_room_id }}');
    directLink.href = config.directUrl;
  }
});

function launchJitsiSession(roomId) {
  const container = document.getElementById('jitsi-container');
  // Match the container's computed height so Jitsi fills the responsive space
  const containerHeight = container.offsetHeight || 380;
  container.innerHTML = '';

  const config = getJitsiConfig(roomId);

  // Lazy-load Jitsi / JaaS script if not already loaded
  if (typeof JitsiMeetExternalAPI === 'undefined') {
    const script = document.createElement('script');
    script.src = config.scriptUrl;
    script.onload = () => initJitsi(container, config, containerHeight);
    script.onerror = () => {
      container.innerHTML = `<div class="jitsi-placeholder"><p style="color: #b93829; font-weight: 600;">Unable to load video provider.</p><p style="font-size: 0.85rem; margin-top: 0.5rem;">Please check your connection or <a href="${config.directUrl}" target="_blank" rel="noopener" style="color: var(--accent-primary);">open the meeting in a new tab</a>.</p></div>`;
    };
    document.head.appendChild(script);
  } else {
    initJitsi(container, config, containerHeight);
  }
}

function initJitsi(container, config, height) {
  const options = {
    roomName: config.roomName,
    width: '100%',
    height: height,
    parentNode: container,
    configOverwrite: {
      startWithAudioMuted: true,
      startWithVideoMuted: false,
      disableThirdPartyRequests: true,
    },
    interfaceConfigOverwrite: {
      TOOLBAR_BUTTONS: ['microphone', 'camera', 'chat', 'raisehand', 'tileview', 'hangup']
    }
  };
  try {
    new JitsiMeetExternalAPI(config.domain, options);
  } catch (e) {
    container.innerHTML = `<div class="jitsi-placeholder"><p style="color: #b93829; font-weight: 600;">Unable to start video session.</p><p style="font-size: 0.85rem; margin-top: 0.5rem;">Please <a href="${config.directUrl}" target="_blank" rel="noopener" style="color: var(--accent-primary);">open the meeting directly in a new tab</a> or contact your facilitator.</p></div>`;
  }
}
</script>
