<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Nguvu Pamoja" }}</title>
  <meta name="description" content="Nguvu Pamoja Online Platform — A faith-based support group companion for weekly sessions, check-ins, reflection, and community.">
  <link rel="stylesheet" href="/assets/css/style.css">
  
  <script>
    window.SUPABASE_URL = "{{ env.SUPABASE_URL }}";
    window.SUPABASE_ANON_KEY = "{{ env.SUPABASE_ANON_KEY }}";
    window.JAAS_APP_ID = "{{ env.JAAS_APP_ID }}";
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script src="/assets/js/token.js" defer></script>
  <script src="/assets/js/supabase.js" defer></script>
</head>
<body>
  <div class="site-container">
    <header class="site-header">
      <a href="/" class="site-logo">
        🌿 Nguvu Pamoja
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="nav-toggle-icon">☰</span>
      </button>
      {% set navItems = [
        { label: 'Home', href: '/', active: page.url == '/' },
        { label: 'Check In', href: '/check-in/1/', active: page.url | startsWith('/check-in/') },
        { label: 'Journal', href: '/journal/', active: page.url | startsWith('/journal/') },
        { label: 'Forum', href: '/forum/mens/', active: page.url | startsWith('/forum/') },
        { label: 'Support', href: '/resources/', active: page.url | startsWith('/resources/') }
      ] %}
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        {% for item in navItems %}
          <a href="{{ item.href }}" class="nav-link{% if item.active %} active{% endif %}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
        <div id="user-token-badge" class="token-badge"></div>
      </nav>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>Nguvu Pamoja — Fountwood Community Support Program</p>
      <p style="margin-top: 0.25rem;">
        <a href="/resources/">Crisis Contacts & Support Resources</a> • Confidential & Anonymous
      </p>
    </footer>
  </div>

  <script>
    (function() {
      var toggle = document.querySelector('.nav-toggle');
      var nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', function() {
          var expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', !expanded);
          nav.classList.toggle('open');
        });
        // Close menu when a link is clicked
        nav.querySelectorAll('.nav-link').forEach(function(link) {
          link.addEventListener('click', function() {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    })();
  </script>
</body>
</html>
