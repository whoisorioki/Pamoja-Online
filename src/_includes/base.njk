<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Nguvu Pamoja" }}</title>
  <meta name="description" content="Nguvu Pamoja Online Platform — A faith-based support group companion for weekly sessions, check-ins, reflection, and community.">
  <link rel="stylesheet" href="/assets/css/style.css">
  
  <script>
    window.SUPABASE_URL = "{{ env.SUPABASE_URL }}";
    window.SUPABASE_ANON_KEY = "{{ env.SUPABASE_ANON_KEY }}";
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script src="/assets/js/token.js" defer></script>
  <script src="/assets/js/supabase.js" defer></script>
</head>
<body>
  <div class="site-container">
    <header class="site-header">
      <a href="/" class="site-logo">
        🌿 Nguvu Pamoja
      </a>
      <nav class="site-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/check-in/1/" class="nav-link">Check-in</a>
        <a href="/journal/" class="nav-link">Journal</a>
        <a href="/forum/mens/" class="nav-link">Forum</a>
        <a href="/resources/" class="nav-link">Support</a>
        <div id="user-token-badge"></div>
      </nav>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>Nguvu Pamoja — Fountwood Community Support Program</p>
      <p style="margin-top: 0.25rem;">
        <a href="/resources/">Crisis Contacts & Support Resources</a> • Confidential & Anonymous
      </p>
    </footer>
  </div>
</body>
</html>
